# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ---------------------------------------------------------------------------
# Hugging Face access token (REQUIRED for the gated pyannote diarization models).
#   1. Create a token: https://huggingface.co/settings/tokens
#   2. Accept the license terms for BOTH of these model pages while logged in:
#        - https://huggingface.co/pyannote/speaker-diarization-3.1
#        - https://huggingface.co/pyannote/segmentation-3.0
#      (Accepting only the diarization pipeline yields a confusing 403.)
# ---------------------------------------------------------------------------
HF_TOKEN=

# Inference device: cuda | cpu
DEVICE=cuda

# Model cache directory (keeps runs reproducible and offline-capable).
# Relative paths resolve against the project root.
HF_HOME=./models_cache

# Runtime storage paths.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts
