# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# ---------------------------------------------------------------------------
# Hugging Face access token (REQUIRED for the gated pyannote diarization models).
#   1. Create a token: https://huggingface.co/settings/tokens
#   2. Accept the licence terms on BOTH pages below, while logged in AS THE SAME
#      ACCOUNT the token belongs to:
#        - https://huggingface.co/pyannote/speaker-diarization-community-1
#        - https://huggingface.co/pyannote/segmentation-3.0
#
#   IMPORTANT: pyannote.audio 4.x resolves the "speaker-diarization-3.1"
#   pipeline THROUGH speaker-diarization-community-1, from which it fetches
#   plda/xvec_transform.npz. Accepting 3.1 alone is NOT enough and produces:
#       GatedRepoError 403 ... you are not in the authorized list
#   Both pages must already show "Agree and access repository" for you.
# ---------------------------------------------------------------------------
HF_TOKEN=

# Inference device: cuda | cpu
DEVICE=cuda

# Model cache directory (keeps runs reproducible and offline-capable).
# Relative paths resolve against the project root.
HF_HOME=./models_cache

# Runtime storage paths.
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
ARTIFACT_DIR=./data/artifacts
